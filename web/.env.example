API_URL="http://localhost:8000"

# origin ที่ "ผู้ใช้เห็นในเบราว์เซอร์" — ใช้ประกอบ redirect_uri ของ Google/LINE
# (ดู src/lib/public-origin.ts) ต้องตรงเป๊ะกับ FRONTEND_URL ฝั่ง api และกับที่
# ลงทะเบียนไว้ใน Google/LINE console ไม่งั้นเจอ redirect_uri_mismatch
#
# ที่ localhost ไม่ต้องตั้งก็ได้ — ไม่มี proxy คั่น โค้ดจะใช้ origin ของ request เอง
# แต่ **บน production ต้องตั้งเสมอ** เพราะ proxy เขียน Host เป็นปลายทางจริง
# ทำให้ Next ประกอบได้ https://localhost:3000 ซึ่งไม่มีอยู่จริง
APP_URL="http://localhost:3000"

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_LINE_LOGIN_CHANNEL_ID=""
