// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/database/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum StockMovementType {
  MANUAL_ADJUSTMENT
  CHAT_ADJUSTMENT
  SALE
  SALE_VOID
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum StockMovementSource {
  WEB
  LINE
}

enum PendingActionSource {
  WEB
  LINE
}

enum PendingActionIntent {
  ADJUST_STOCK
  // [อั้ม] ขายผ่านแชท — ตัดสต็อกพร้อมคิดเงิน แยกจาก ADJUST_STOCK ที่ลดของเฉยๆ
  SELL
  // [อั้ม] ย้ายของไปร้านอื่นของเจ้าของคนเดียวกัน ปลายทางอยู่ที่ destinationShopId
  TRANSFER_STOCK
}

enum StockOperation {
  INCREASE
  DECREASE
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model StockMovement {
  id              String              @id @default(uuid()) @db.Uuid
  shopId          String              @db.Uuid
  shopProductId   String              @db.Uuid
  actorId         String?             @db.Uuid
  saleId          String?             @map("sale_id") @db.Uuid
  pendingActionId String?             @map("pending_action_id") @db.Uuid
  movementType    StockMovementType
  quantityDelta   Int
  quantityBefore  Int
  quantityAfter   Int
  source          StockMovementSource
  /// [เซิ่น] ทุนต่อชิ้นของการเคลื่อนไหวครั้งนี้
  ///
  /// ของเข้า = ทุนของล็อตที่เพิ่งเปิด
  /// ของออก = ทุนเฉลี่ยถ่วงน้ำหนักของล็อตที่ถูกตัดจริง (ดู StockLotsService.consume)
  ///
  /// nullable โดยตั้งใจ — รายการที่เกิดก่อนระบบล็อตไม่มีทุนให้บันทึก และ
  /// หน้าเว็บต้องแสดงเป็น "—" ไม่ใช่ ฿0.00 เพราะไม่มีข้อมูลกับทุนเป็นศูนย์
  /// เป็นคนละเรื่องกัน (หลักเดียวกับ shop_products.cost_price = 0)
  unitCost        Decimal?            @map("unit_cost") @db.Decimal(12, 2)
  note            String?
  referenceType   String?
  referenceId     String?
  createdAt       DateTime            @default(now())
  shop            Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopProduct     ShopProduct         @relation(fields: [shopProductId], references: [id], onDelete: Restrict)
  actor           User?               @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: Restrict)
  sale            Sale?               @relation(fields: [saleId], references: [id], onDelete: Restrict)
  pendingAction   PendingAction?      @relation(fields: [pendingActionId], references: [id], onDelete: Restrict)

  @@unique([referenceType, referenceId])
  @@index([shopId, createdAt(sort: Desc)])
  @@index([shopId, shopProductId, createdAt(sort: Desc)])
  @@index([shopId, actorId, createdAt(sort: Desc)])
  @@index([shopId, movementType, createdAt(sort: Desc)])
  @@index([saleId])
  @@index([pendingActionId])
}

model PendingAction {
  id                String              @id @default(uuid()) @db.Uuid
  shopId            String              @db.Uuid
  actorId           String?             @db.Uuid
  source            PendingActionSource
  originalMessage   String
  intent            PendingActionIntent
  shopProductId     String?             @db.Uuid
  productQuery      String
  operation         StockOperation
  quantity          Int
  status            PendingActionStatus @default(PENDING)
  payload           Json?
  parsedItems       Json?               @map("parsed_items")
  /// [อั้ม] ร้านปลายทางของ intent = TRANSFER_STOCK เท่านั้น intent อื่นเป็น null
  ///
  /// แยกเป็นคอลัมน์ ไม่ยัดลง payload เพราะ payload ถูกใช้เก็บรายการตัวเลือก
  /// ตอนชื่อสินค้ากำกวมอยู่แล้ว (StockChoiceService) ถ้าเอามาปนกัน คำสั่งย้าย
  /// ที่ชื่อสินค้ากำกวมจะทับกันเอง
  destinationShopId String?             @map("destination_shop_id") @db.Uuid
  expiresAt         DateTime
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  shop              Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  destinationShop   Shop?               @relation("PendingActionDestination", fields: [destinationShopId], references: [id], onDelete: Restrict)
  shopProduct       ShopProduct?        @relation(fields: [shopProductId], references: [id], onDelete: Restrict)
  actor             User?               @relation("PendingActionActor", fields: [actorId], references: [id], onDelete: Restrict)
  stockMovements    StockMovement[]

  @@index([shopId, status, createdAt(sort: Desc)])
  @@index([expiresAt, status])
}

model Sale {
  id             String          @id @default(uuid()) @db.Uuid
  shopId         String          @db.Uuid
  staffId        String          @db.Uuid
  saleNo         String          @default(cuid()) @map("sale_no") @db.VarChar(30)
  itemCount      Int             @default(0) @map("item_count")
  status         SaleStatus      @default(COMPLETED)
  totalAmount    Decimal         @db.Decimal(18, 2)
  note           String?
  voidedById     String?         @db.Uuid
  voidReason     String?
  voidedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          SaleItem[]
  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  staff          User            @relation("SaleStaff", fields: [staffId], references: [id], onDelete: Restrict)
  voidedBy       User?           @relation("SaleVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]

  @@unique([shopId, saleNo])
  @@index([shopId, createdAt(sort: Desc)])
  @@index([shopId, status, createdAt(sort: Desc)])
}

model SaleItem {
  id            String      @id @default(uuid()) @db.Uuid
  saleId        String      @db.Uuid
  shopProductId String      @db.Uuid
  productName   String
  barcode       String?     @db.VarChar(50)
  unitPrice     Decimal     @db.Decimal(18, 2)
  costPrice     Decimal     @default(0) @map("cost_price") @db.Decimal(18, 2)
  quantity      Int
  lineTotal     Decimal     @db.Decimal(18, 2)
  createdAt     DateTime    @default(now())
  sale          Sale        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  shopProduct   ShopProduct @relation(fields: [shopProductId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([shopProductId])
}

enum UserRole {
  SHOP_OWNER
  SHOP_STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  email              String?
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(2)
  username           String?    @db.VarChar(50)
  password           String?    @map("password")
  lineUserId         String?    @unique @map("line_user_id")
  googleId           String?    @unique @map("google_id")
  ownerId            String?    @map("owner_id") @db.Uuid
  role               UserRole
  twoFactorEnabled   Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecretEnc String?    @map("two_factor_secret_enc")
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(2)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(2)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(2)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(2)

  owner                   User?                    @relation("OwnerStaff", fields: [ownerId], references: [id], onDelete: Restrict)
  staff                   User[]                   @relation("OwnerStaff")
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  twoFactorRecoveryCodes  TwoFactorRecoveryCode[]
  adminAuditLogs          AdminAuditLog[]          @relation("AdminAuditActor")
  // feature/subscriptions-resource + feature/shops-resource (พี่ปาน)
  subscription            Subscription?
  shops                   Shop[]
  // feature/payments-resource (แพรว)
  payments                Payment[]
  // feature/staff-resource (อั้ม) — back-relation ที่ Prisma บังคับ
  shopStaffs              ShopStaff[]
  // [เซิ่น] feature/notifications-resource — back-relation ที่ Prisma บังคับ
  notifications           Notification[]
  permissionsGranted      StaffPermission[]
  stockMovements          StockMovement[]          @relation("StockMovementActor")
  pendingActions          PendingAction[]          @relation("PendingActionActor")
  salesCreated            Sale[]                   @relation("SaleStaff")
  salesVoided             Sale[]                   @relation("SaleVoidedBy")
  // [อั้ม] feature/chatbot-resource — back-relation ที่ Prisma บังคับ
  chatMessages            ChatMessage[]
  chatShopPrompt          ChatShopPrompt? // [อั้ม] feature/chatbot-resource — ค้างได้คนละ 1 คำถาม

  @@index([email], name: "idx_user_email")
  @@index([username], name: "idx_user_username")
  @@index([lineUserId], name: "idx_user_line")
  @@index([googleId], name: "idx_user_google")
  @@index([ownerId], name: "idx_user_owner")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  usedAt    DateTime? @map("used_at") @db.Timestamptz(2)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(2)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(2)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_token_user")
  @@index([familyId], name: "idx_refresh_token_family")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(2)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(2)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_password_reset_user")
  @@map("password_reset_tokens")
}

/// ลิงก์ยืนยันอีเมลตอนสมัครด้วยอีเมล — บัญชีที่มี email แต่ยังไม่ยืนยัน
/// จะ login ด้วยรหัสผ่านไม่ได้ (users.email_verified_at IS NULL)
/// บัญชีที่สมัครด้วย Google ถือว่ายืนยันแล้วทันที เพราะ Google ยืนยันให้
model EmailVerificationToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  pendingEmail String?   @map("pending_email")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(2)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(2)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_email_verification_user")
  @@map("email_verification_tokens")
}

enum AdminAuditAction {
  USER_SUSPEND
  USER_REACTIVATE
  USER_ROLE_CHANGE
  SHOP_SUSPEND
  SHOP_REACTIVATE
}

enum AdminAuditTargetType {
  USER
  SHOP
}

/// APPEND-ONLY — บันทึกทุก action ที่ Admin/Super Admin ทำกับบัญชีและร้านค้า
/// ห้าม UPDATE/DELETE แถวเดิม (เหมือน stock_movements และ payments)
///
/// target_id ไม่มี FK เพราะชี้ได้ทั้ง users และ shops แล้วแต่ target_type
/// actor ใช้ onDelete: Restrict เพื่อไม่ให้ประวัติหายเมื่อบัญชีแอดมินถูกลบ
model AdminAuditLog {
  id         String               @id @default(uuid()) @db.Uuid
  actorId    String               @map("actor_id") @db.Uuid
  action     AdminAuditAction
  targetType AdminAuditTargetType @map("target_type")
  targetId   String               @map("target_id") @db.Uuid
  reason     String?
  /// ข้อมูลเพิ่มเติมแล้วแต่ action เช่น เปลี่ยน role เก็บ { from, to }
  metadata   Json?
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(2)

  actor User @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt], name: "idx_admin_audit_actor")
  @@index([targetType, targetId, createdAt], name: "idx_admin_audit_target")
  @@map("admin_audit_logs")
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(2)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_2fa_recovery_user")
  @@map("two_factor_recovery_codes")
}

model categories {
  id           String   @id @default(uuid(7)) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  name         String   @db.VarChar(100)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[] // [เซิ่น] back-relation ที่ Prisma บังคับ — บรรทัดเดียว ไม่แตะ field อื่น

  @@unique([ownerId, name], map: "uq_category_owner_name")
  @@map("categories")
}

// =====================================================

// feature/subscriptions-resource + feature/shops-resource (พี่ปาน)
// ============================================================

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
}

model SubscriptionPlan {
  id                 String  @id @default(uuid()) @db.Uuid
  code               String  @unique @db.VarChar(50) // FREE / PLUS / PRO
  nameTh             String  @map("name_th") @db.VarChar(100)
  priceThb           Decimal @map("price_thb") @db.Decimal(12, 2)
  durationMonths     Int?    @map("duration_months") // NULL = Free Plan ไม่มีวันหมดอายุ
  includedShopQuota  Int     @default(1) @map("included_shop_quota") // Free = 1, Plus = 3, Pro = 5
  includedStaffQuota Int     @default(0) @map("included_staff_quota") // Free = 0, Plus = 6, Pro = 10
  maxActiveProducts  Int?    @map("max_active_products") // Free = 100, Plus = 3000, Pro = 5000 (SRS §69-71)

  /// SRS §116/§171/§179/§193 — ประตูระดับแพ็กเกจ ต้องผ่านคู่กับ staff_permissions
  /// เสมอ (ดู "Permission checks" ใน AGENTS.md) เจ้าของร้านเปิดสิทธิ์ให้พนักงาน
  /// ได้ แต่ถ้าแพ็กเกจไม่ปลดล็อกก็ต้องถูกบล็อกอยู่ดี
  chatbotEnabled          Boolean @default(false) @map("chatbot_enabled") // Plus/Pro (AI Chat)
  barcodeEnabled          Boolean @default(false) @map("barcode_enabled") // Plus/Pro (ตัดสต็อกด้วยบาร์โค้ด)
  aiRecommendationEnabled Boolean @default(false) @map("ai_recommendation_enabled") // Pro เท่านั้น

  isFree   Boolean @default(false) @map("is_free")
  isActive Boolean @default(true) @map("is_active")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @unique @map("user_id") @db.Uuid
  planId           String             @map("plan_id") @db.Uuid
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @map("started_at")
  expiresAt        DateTime?          @map("expires_at") // NULL สำหรับ Free Plan
  expiryNotifiedAt DateTime?          @map("expiry_notified_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  // feature/payments-resource (แพรว) — back-relation ที่ Prisma บังคับ
  payments Payment[]

  @@index([expiresAt], name: "idx_subscription_expires")
  @@map("subscriptions")
}

// =====================================================================
// feature/payments-resource (แพรว)
// ทำให้ TODO ใน SubscriptionsService.upgrade()/renew() ทำงานได้: ทุกครั้งที่
// อัปเกรด/ต่ออายุ ต้องสร้าง Payment แถวใหม่คู่กันในทรานแซกชันเดียว
// =====================================================================

/// SRS §66/§110: quota เปลี่ยนได้ทางเดียวคืออัปเกรดแพลน — ไม่มีการซื้อ
/// ร้าน/สินค้า/พนักงานเพิ่มแยกต่างหาก จึงมีแค่ 2 purpose (ตัดสินใจกับทีมแล้ว
/// ดู "SRS alignment" ใน AGENTS.md — ห้ามเพิ่ม EXTRA_SHOP กลับเข้ามา)
enum PaymentPurpose {
  NEW_SUBSCRIPTION
  RENEWAL
}

enum PaymentStatus {
  PENDING
  PAID
  /// จ่ายไม่ผ่าน หรือใบหมดอายุแล้วถูก cron เก็บกวาด
  FAILED
  /// ผู้ใช้กดยกเลิกใบที่ค้างอยู่เอง — แยกจาก FAILED เพราะผู้ใช้ต้องอ่านออกว่า
  /// "เราเลิกเอง" ไม่ใช่ "บัตรมีปัญหา" และเป็นเงื่อนไขเดียวที่ปลดล็อกให้เปิด
  /// ใบใหม่ได้ก่อนหมดหน้าต่าง 24 ชม.
  CANCELLED
  REFUNDED
}

/// APPEND-ONLY — ห้าม UPDATE ยอดเงินของแถวเดิม คืนเงินให้สร้างแถวใหม่
/// status = REFUNDED แทน (เหมือน stock_movements: ledger ไม่ใช่ state)
model Payment {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  subscriptionId String?        @map("subscription_id") @db.Uuid
  purpose        PaymentPurpose
  amountThb      Decimal        @map("amount_thb") @db.Decimal(12, 2)
  currency       String         @default("THB") @db.Char(3)
  status         PaymentStatus  @default(PENDING)
  provider       String         @db.VarChar(50) // "stripe"
  providerRef    String         @unique @map("provider_ref")
  paidAt         DateTime?      @map("paid_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], name: "idx_payment_user_date")
  @@map("payments")
}

model Shop {
  id          String     @id @default(uuid()) @db.Uuid
  ownerId     String     @map("owner_id") @db.Uuid
  name        String     @db.VarChar(150)
  description String?
  imageUrl    String?    @map("image_url") @db.VarChar(500)
  phone       String?    @db.VarChar(20)
  address     String?
  latitude    Decimal?   @db.Decimal(9, 6)
  longitude   Decimal?   @db.Decimal(9, 6)
  status      ShopStatus @default(ACTIVE)
  pausedAt    DateTime?  @map("paused_at") // เจ้าของพักร้านชั่วคราวเอง — คนละความหมายกับ status=SUSPENDED ที่ Admin เป็นคนตั้งเท่านั้น (SRS §185)
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  staff             ShopStaff[] // [อั้ม] feature/staff-resource — back-relation ที่ Prisma บังคับ บรรทัดเดียว ไม่แตะ field อื่น
  sales             Sale[]
  shopProducts      ShopProduct[]
  stockMovements    StockMovement[]
  pendingActions    PendingAction[]
  notifications     Notification[] // [เซิ่น] feature/notifications-resource
  chatMessages      ChatMessage[] // [อั้ม] feature/chatbot-resource — back-relation ที่ Prisma บังคับ
  chatShopPrompts   ChatShopPrompt[] // [อั้ม] feature/chatbot-resource — ร้านที่เลือกค้างไว้ใน LINE
  incomingTransfers PendingAction[]    @relation("PendingActionDestination") // [อั้ม] ร้านนี้เป็นปลายทางของคำสั่งย้าย
  aiRecommendations AiRecommendation[] // [อั้ม] feature/ai-recommendations-resource

  @@index([ownerId, deletedAt], name: "idx_shop_owner")
  @@map("shops")
}

// =====================================================================
// feature/staff-resource (อั้ม)
// Reviewed against SRS 2026-08-20, ดู api/prisma/design/schema.dbml
// =====================================================================

/// พนักงานที่ถูกมอบหมายเข้าร้าน — เจ้าของร้านไม่มีแถวในตารางนี้ สิทธิ์เต็มมาจาก
/// shops.ownerId โดยตรง พนักงาน 1 คนมอบหมายได้หลายร้าน (หลายแถว) แต่นับเป็น
/// 1 คนใน staff quota เสมอ (SRS: "จัดสรรพนักงานจาก staff quota กลาง...ได้อย่างอิสระ")
model ShopStaff {
  id         String    @id @default(uuid(7)) @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6) // soft remove — เก็บประวัติผู้ทำรายการไว้

  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  permission StaffPermission?

  @@unique([shopId, userId], map: "uq_shop_staff")
  @@index([userId, removedAt], name: "idx_shop_staff_user")
  @@map("shop_staffs")
}

/// สิทธิ์การใช้งานของพนักงาน 1:1 กับ ShopStaff — สิทธิ์กำหนดแยกรายร้าน
/// ค่าเริ่มต้นทุกสิทธิ์ = false เสมอ (SRS: "บัญชีพนักงานที่สร้างใหม่ต้องไม่มีสิทธิ์ใดๆ")
/// ต้องเช็คคู่กับ subscription_plans ของเจ้าของร้านเสมอ 2 ชั้นก่อนอนุญาต action ใดๆ
model StaffPermission {
  id                   String   @id @default(uuid(7)) @db.Uuid
  shopStaffId          String   @unique @map("shop_staff_id") @db.Uuid
  canManageProduct     Boolean  @default(false) @map("can_manage_product")
  canAdjustStockManual Boolean  @default(false) @map("can_adjust_stock_manual")
  canUseChatbot        Boolean  @default(false) @map("can_use_chatbot")
  canScanSale          Boolean  @default(false) @map("can_scan_sale")
  canViewDashboard     Boolean  @default(false) @map("can_view_dashboard")
  canViewAiInsight     Boolean  @default(false) @map("can_view_ai_insight")
  grantedBy            String?  @map("granted_by") @db.Uuid // user id ของเจ้าของร้านที่แก้ไขล่าสุด
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  shopStaff     ShopStaff @relation(fields: [shopStaffId], references: [id], onDelete: Cascade)
  grantedByUser User?     @relation(fields: [grantedBy], references: [id], onDelete: SetNull)

  @@map("staff_permissions")
}

// ต้องเพิ่มเองใน migration ภายหลัง (Prisma schema เขียนไม่ได้โดยตรง):
// - Seed subscription_plans 3 แถวตาม SRS ฉบับล่าสุด (จำนวนร้าน/สินค้า/
//   พนักงาน เป็นจำนวนตายตัวตามแพ็กเกจ ไม่มีการซื้อสิทธิ์เพิ่มแยกต่างหาก
//   ต้องอัปเกรดแพ็กเกจเท่านั้นถึงจะได้ quota เพิ่ม):
//   - FREE: isFree=true, priceThb=0, includedShopQuota=1, includedStaffQuota=0,
//     maxActiveProducts=100, durationMonths=NULL
//   - PLUS: isFree=false, priceThb=2499, includedShopQuota=3, includedStaffQuota=6,
//     maxActiveProducts=3000, durationMonths=12
//   - PRO: isFree=false, priceThb=3499, includedShopQuota=5, includedStaffQuota=10,
//     maxActiveProducts=5000, durationMonths=12
// - Logic คำนวณ quota / read-only ดู subscription-quota.util.ts
//   (allowed = includedShopQuota ตรงๆ ตามแพ็กเกจ, used = COUNT(shops
//   WHERE ownerId = userId AND deletedAt IS NULL), สร้างร้านได้เมื่อ
//   status = ACTIVE AND used < allowed)
// =====================================================================
// [เซิ่น] feature/products-resource + feature/shop-products-resource
// =====================================================================

/// Product Catalog กลาง ระดับเจ้าของร้าน (owner) — ใช้ร่วมกันได้ทุกร้าน
/// SRS: สินค้าเดียวกันใช้หลายร้าน นับ product quota เพียง 1 รายการ
model Product {
  id         String    @id @default(uuid(7)) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  categoryId String?   @map("category_id") @db.Uuid
  name       String    @db.VarChar(200)
  barcode    String?   @db.VarChar(50)
  unit       String    @db.VarChar(20)
  imageUrl   String?   @map("image_url") @db.VarChar(500)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category     categories?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shopProducts ShopProduct[]

  @@index([ownerId, deletedAt], name: "idx_product_owner_deleted")
  @@index([ownerId, name], name: "idx_product_owner_name")
  @@index([categoryId], name: "idx_product_category")
  @@map("products")
}

enum ShopProductStatus {
  ACTIVE
  INACTIVE

  @@map("shop_product_status")
}

/// สินค้าที่แต่ละร้านเลือกมาขาย — ราคาขาย/ต้นทุน/สต็อก แยกตามร้าน
/// SRS: "ข้อมูลระดับร้านต้องประกอบด้วยราคาขาย ต้นทุน จำนวน stock low-stock threshold และสถานะ"
model ShopProduct {
  id                String            @id @default(uuid(7)) @db.Uuid
  shopId            String            @map("shop_id") @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  sellPrice         Decimal           @map("sell_price") @db.Decimal(12, 2)
  costPrice         Decimal           @map("cost_price") @db.Decimal(12, 2)
  stockQty          Int               @default(0) @map("stock_qty")
  lowStockThreshold Int               @default(0) @map("low_stock_threshold")
  status            ShopProductStatus @default(ACTIVE)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  stockMovements    StockMovement[]
  pendingActions    PendingAction[]
  saleItems         SaleItem[]
  aiRecommendations AiRecommendation[] // [อั้ม] feature/ai-recommendations-resource
  stockLots         StockLot[] // [เซิ่น] feature/stock-lots — ต้นทุนแยกตามล็อตที่รับเข้า

  @@unique([shopId, productId], map: "uq_shop_product")
  @@index([shopId, status], name: "idx_shop_product_shop_status")
  @@index([productId], name: "idx_shop_product_product")
  @@map("shop_products")
}

/// [เซิ่น] ล็อตสินค้าที่รับเข้าแต่ละครั้ง พร้อมต้นทุนของล็อตนั้น
///
/// เหตุผลที่ต้องมี: shop_products.cost_price เก็บได้ค่าเดียว พอรับของล็อตใหม่
/// ที่ต้นทุนไม่เท่าเดิม ของเก่าที่ยังขายไม่หมดจะถูกตีเป็นราคาใหม่ไปด้วย
/// กำไรของที่ยังไม่ได้ขายจึงคลาดเคลื่อนทันที ตารางนี้เก็บแต่ละล็อตแยกกัน
/// แล้วตัดของเก่าก่อน (FIFO) ตามลำดับ received_at
///
/// qty_remaining ลดลงเมื่อของถูกตัดออก ล็อตที่เหลือ 0 ไม่ลบทิ้ง เก็บไว้เป็น
/// ประวัติว่าเคยรับของราคานี้เข้ามาเมื่อไหร่ และ unit_cost ของบิลเก่าต้องตรวจย้อนได้
///
/// shop_products.cost_price ยังอยู่และยังใช้อยู่ — ทำหน้าที่เป็นค่าตั้งต้นของ
/// ล็อตใหม่ที่ไม่ได้ระบุต้นทุนมา และเป็นค่าสำรองสำหรับสินค้าที่ยังไม่มีล็อต
model StockLot {
  id            String   @id @default(uuid(7)) @db.Uuid
  shopProductId String   @map("shop_product_id") @db.Uuid
  unitCost      Decimal  @map("unit_cost") @db.Decimal(12, 2)
  qtyReceived   Int      @map("qty_received")
  qtyRemaining  Int      @map("qty_remaining")
  note          String?
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shopProduct ShopProduct @relation(fields: [shopProductId], references: [id], onDelete: Restrict)

  /// ตัดของเก่าก่อน — คิวรีหลักคือ "ล็อตของสินค้านี้ที่ยังเหลือ เรียงเก่าสุดก่อน"
  @@index([shopProductId, receivedAt], name: "idx_stock_lot_fifo")
  @@map("stock_lots")
}

// =====================================================================
// [เซิ่น] feature/notifications-resource
// อ้างอิง prisma/design/schema.dbml -> Enum notification_type (บรรทัด 114)
// และ Table notifications (บรรทัด 624)
// =====================================================================

enum NotificationType {
  LOW_STOCK
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  ACCOUNT_SUSPENDED
  PRODUCT_LIMIT_REACHED
  SHOP_LIMIT_REACHED

  @@map("notification_type")
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  shopId    String?          @map("shop_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String
  payload   Json?
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([userId, readAt], name: "idx_notification_unread")
  @@map("notifications")
}

// =====================================================================
// [อั้ม] feature/chatbot-resource — ประวัติแชท
// ตรงตามไฟล์ SQL อ้างอิง: chat_channel / chat_role / chat_messages
// pending_action_id เก็บเป็น uuid เปล่า ไม่ผูก relation กับ model PendingAction
// ของพี่ดิว เพื่อไม่ให้ต้องแก้ไฟล์ในโมดูลของเขา
// =====================================================================

enum ChatChannel {
  WEB
  LINE

  @@map("chat_channel")
}

enum ChatRole {
  USER
  ASSISTANT

  @@map("chat_role")
}

model ChatMessage {
  id              String      @id @default(uuid(7)) @db.Uuid
  shopId          String      @map("shop_id") @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  channel         ChatChannel
  role            ChatRole
  content         String
  pendingActionId String?     @map("pending_action_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([shopId, userId, createdAt], name: "idx_chat_scope_date")
  @@map("chat_messages")
}

/// [อั้ม] feature/chatbot-resource
/// จำคำสั่งที่ผู้ใช้พิมพ์มา ระหว่างรอให้เลือกว่าหมายถึงร้านไหน (เฉพาะคนที่มีหลายร้าน)
///
/// แยกจาก PendingAction เพราะตอนถามว่า "ร้านไหน" เรายังไม่รู้ shopId แต่
/// PendingAction.shopId เป็น NOT NULL + มี FK จึงเก็บสถานะช่วงนี้ไม่ได้
///
/// ต้องเก็บลงฐานข้อมูล ไม่ใช่หน่วยความจำ เพราะ webhook ของ LINE เป็น HTTP ไร้สถานะ
/// ข้อความถัดไปอาจมาถึงคนละ process และ production รีสตาร์ตทุกครั้งที่ deploy
model ChatShopPrompt {
  id              String   @id @default(uuid(7)) @db.Uuid
  /// unique เพื่อให้คำถามใหม่ทับของเก่าด้วย upsert — คนหนึ่งค้างได้คำถามเดียว
  userId          String   @unique @map("user_id") @db.Uuid
  originalMessage String   @map("original_message")
  /// ร้านที่ผู้ใช้เพิ่งเลือก — ว่าง = ยังไม่ได้เลือก (เลขที่พิมพ์มาแปลว่า "เลือกร้าน")
  /// มีค่า = เลือกแล้ว (เลขที่พิมพ์มาแปลว่า "เลือกสินค้า" และ "ยืนยัน" ใช้ร้านนี้)
  ///
  /// จำเป็นเพราะข้อความ LINE ทุกครั้งมาแบบไร้บริบท ถ้าไม่จำไว้ พอผู้ใช้พิมพ์
  /// "ยืนยัน" ระบบจะถามว่าร้านไหนซ้ำอีกรอบ วนไม่จบ
  selectedShopId  String?  @map("selected_shop_id") @db.Uuid
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedShop Shop? @relation(fields: [selectedShopId], references: [id], onDelete: Cascade)

  @@map("chat_shop_prompts")
}

// =====================================================================
// [อั้ม] feature/ai-recommendations-resource
// ตรงตาม prisma/design/schema.dbml (Table ai_recommendations)
// ใช้ได้เฉพาะ Pro Plan — เช็ค subscription_plans.ai_recommendation_enabled
// cache ผลไว้ ไม่เรียก LLM ตอน render แดชบอร์ด (SRS §179-§181)
// =====================================================================

enum AiRecommendationType {
  RESTOCK
  CLEARANCE
  PROMOTION

  @@map("ai_recommendation_type")
}

model AiRecommendation {
  id            String               @id @default(uuid(7)) @db.Uuid
  shopId        String               @map("shop_id") @db.Uuid
  shopProductId String?              @map("shop_product_id") @db.Uuid
  type          AiRecommendationType
  title         String               @db.VarChar(200)
  content       String
  metrics       Json?
  generatedAt   DateTime             @default(now()) @map("generated_at") @db.Timestamptz(6)
  validUntil    DateTime?            @map("valid_until") @db.Timestamptz(6)
  isDismissed   Boolean              @default(false) @map("is_dismissed")

  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopProduct ShopProduct? @relation(fields: [shopProductId], references: [id], onDelete: Cascade)

  @@index([shopId, generatedAt], name: "idx_ai_reco_shop_date")
  @@map("ai_recommendations")
}

/// [แพรว] บันทึกว่าไฟล์ไหนใน prisma/sql/ ถูกรันไปแล้ว — เขียนโดย SqlScriptsRunner
/// ไม่ใช่ข้อมูลธุรกิจ แต่ต้องประกาศไว้ที่นี่ ไม่งั้น `db push` จะเห็นเป็นตาราง
/// แปลกปลอมแล้วขอลบทิ้งทุกครั้ง (ต้องตอบ --accept-data-loss ถึงจะผ่าน)
model SqlScript {
  filename  String   @id
  checksum  String
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("_sql_scripts")
}
