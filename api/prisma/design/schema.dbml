// =====================================================================
// Aum Manage Stocks — Retail Shop Stock Management Platform
// DBML for dbdiagram.io  (https://dbdiagram.io/d)
//
// Generated from api/prisma/schema.prisma on 2026-11-02 — schema.prisma is
// what the database really uses, so table, column and enum names here are
// the real ones. Four models have no @@map (StockMovement, Sale, SaleItem,
// PendingAction), so their tables and columns keep Prisma's PascalCase /
// camelCase names.
//
// Notes carried over from the earlier hand-written design file where the
// column still exists. Requirements live in the SRS (Google Doc
// "SRS - Aum Manage Stocks").
//
// Not expressible in DBML: partial unique indexes and seed data live in
// api/prisma/sql/*.sql (SqlScriptsRunner applies them on boot).
// =====================================================================

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------
Enum StockMovementType {
  MANUAL_ADJUSTMENT
  CHAT_ADJUSTMENT
  SALE
  SALE_VOID
}
Enum SaleStatus {
  COMPLETED
  VOIDED
}
Enum StockMovementSource {
  WEB
  LINE
}
Enum PendingActionSource {
  WEB
  LINE
}
Enum PendingActionIntent {
  ADJUST_STOCK
  SELL
  TRANSFER_STOCK
}
Enum StockOperation {
  INCREASE
  DECREASE
}
Enum PendingActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}
Enum UserRole {
  SHOP_OWNER
  SHOP_STAFF
  ADMIN
  SUPER_ADMIN
}
Enum UserStatus {
  ACTIVE
  SUSPENDED
}
Enum AdminAuditAction {
  USER_SUSPEND
  USER_REACTIVATE
  USER_ROLE_CHANGE
  SHOP_SUSPEND
  SHOP_REACTIVATE
}
Enum AdminAuditTargetType {
  USER
  SHOP
}
Enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}
Enum ShopStatus {
  ACTIVE
  SUSPENDED
}
Enum PaymentPurpose {
  NEW_SUBSCRIPTION
  RENEWAL
}
Enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}
Enum shop_product_status {
  ACTIVE
  INACTIVE
}
Enum notification_type {
  LOW_STOCK
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  ACCOUNT_SUSPENDED
  PRODUCT_LIMIT_REACHED
  SHOP_LIMIT_REACHED
}
Enum chat_channel {
  WEB
  LINE
}
Enum chat_role {
  USER
  ASSISTANT
}
Enum ai_recommendation_type {
  RESTOCK
  CLEARANCE
  PROMOTION
}

Table StockMovement {
  id                uuid [pk]
  shopId            uuid [not null]
  shopProductId     uuid [not null, note: 'สต็อกผูกกับคู่ร้าน+สินค้าโดยตรง']
  actorId           uuid [null, note: 'ผู้ทำรายการ']
  sale_id           uuid [null, note: 'มีค่าเมื่อ movementType = SALE หรือ SALE_VOID']
  pending_action_id uuid [null, note: 'มีค่าเมื่อมาจากคำสั่งแชทบอทที่ยืนยันแล้ว']
  movementType      StockMovementType [not null, note: 'ปรับเอง / แชทบอท / ขาย / ยกเลิกบิล']
  quantityDelta     int [not null, note: 'บวก = เพิ่ม, ลบ = ตัดออก']
  quantityBefore    int [not null]
  quantityAfter     int [not null]
  source            StockMovementSource [not null, note: 'ช่องทางที่สั่ง: เว็บ หรือ LINE']
  unit_cost         decimal(12,2) [null, note: 'ของเข้า = ทุนของล็อตที่เพิ่งเปิด / ของออก = ทุนเฉลี่ยถ่วงน้ำหนักของล็อตที่ถูกตัดจริง — null = แถวที่เกิดก่อนมีระบบล็อต ต้องแสดงเป็น "—" ไม่ใช่ 0']
  note              text [null]
  referenceType     text [null, note: 'คู่กับ referenceId กันบันทึกซ้ำ (เช่น การย้ายสต็อก) — UNIQUE(referenceType, referenceId)']
  referenceId       text [null]
  createdAt         timestamp(3) [not null, default: `now()`]

  indexes {
    (referenceType, referenceId) [unique]
    (shopId, createdAt)
    (shopId, shopProductId, createdAt)
    (shopId, actorId, createdAt)
    (shopId, movementType, createdAt)
    (sale_id)
    (pending_action_id)
  }

  Note: '''
  APPEND-ONLY LEDGER — ห้าม UPDATE/DELETE แถวเดิม
  ตารางนี้คือแหล่งความจริงของสต็อก ส่วน shop_products.stock_qty เป็นแค่ cache
  ที่ต้องอัปเดตใน transaction เดียวกันเสมอ
  quantityAfter = quantityBefore + quantityDelta ทุกแถว
  ชื่อตาราง/คอลัมน์เป็น PascalCase/camelCase เพราะ model นี้ไม่มี @@map
  '''
}

Table PendingAction {
  id                  uuid [pk]
  shopId              uuid [not null]
  actorId             uuid [null]
  source              PendingActionSource [not null]
  originalMessage     text [not null, note: 'ข้อความดิบที่ผู้ใช้พิมพ์ เช่น "เพิ่มโค้ก10"']
  intent              PendingActionIntent [not null]
  shopProductId       uuid [null]
  productQuery        text [not null]
  operation           StockOperation [not null]
  quantity            int [not null]
  status              PendingActionStatus [not null, default: 'PENDING']
  payload             jsonb [null, note: 'ตัวเลือกสินค้าเมื่อชื่อกำกวม (StockChoiceService)']
  parsed_items        jsonb [null, note: 'ผลการตีความ: shop_product_id / product_name / qty ต่อรายการ']
  destination_shop_id uuid [null, note: 'ร้านปลายทาง มีค่าเมื่อ intent = TRANSFER_STOCK เท่านั้น']
  expiresAt           timestamp(3) [not null, note: 'กันผู้ใช้กดยืนยันของเก่าข้ามวัน']
  confirmedAt         timestamp(3) [null]
  cancelledAt         timestamp(3) [null]
  createdAt           timestamp(3) [not null, default: `now()`]
  updatedAt           timestamp(3) [not null]

  indexes {
    (shopId, status, createdAt)
    (expiresAt, status)
  }

  Note: '''
  คำสั่งแชทบอทที่รอผู้ใช้ยืนยัน — ต้อง persist ลง DB เพราะการยืนยันจาก LINE
  มาเป็นอีก request หนึ่ง (อีก process ก็ได้)
  intent: ADJUST_STOCK / SELL / TRANSFER_STOCK (ปลายทางอยู่ใน destination_shop_id)
  หมดอายุตาม PENDING_ACTION_TTL_MINUTES (ค่าเริ่มต้น 15 นาที)
  ใช้ได้เฉพาะ Plus / Pro — เช็ค chatbot_enabled ก่อนสร้างแถว
  '''
}

Table Sale {
  id          uuid [pk]
  shopId      uuid [not null]
  staffId     uuid [not null, note: 'ผู้ขาย (แคชเชียร์)']
  sale_no     varchar(30) [not null, default: `cuid()`, note: 'เลขบิล unique ต่อร้าน ต่างร้านซ้ำกันได้']
  item_count  int [not null, default: 0]
  status      SaleStatus [not null, default: 'COMPLETED']
  totalAmount decimal(18,2) [not null]
  note        text [null]
  voidedById  uuid [null, note: 'ผู้ยกเลิกการขาย']
  voidReason  text [null]
  voidedAt    timestamp(3) [null]
  createdAt   timestamp(3) [not null, default: `now()`]
  updatedAt   timestamp(3) [not null]

  indexes {
    (shopId, sale_no) [unique]
    (shopId, createdAt)
    (shopId, status, createdAt)
  }

  Note: '''
  ชื่อตาราง/คอลัมน์เป็น PascalCase/camelCase เพราะ model นี้ไม่มี @@map
  '''
}

Table SaleItem {
  id            uuid [pk]
  saleId        uuid [not null]
  shopProductId uuid [not null, note: 'อ้างอิงเท่านั้น — ห้าม join เอาชื่อ/ราคามาแสดงบนบิลย้อนหลัง']
  productName   text [not null]
  barcode       varchar(50) [null]
  unitPrice     decimal(18,2) [not null]
  cost_price    decimal(18,2) [not null, default: 0, note: 'ไว้คำนวณกำไรย้อนหลังให้ถูกต้อง']
  quantity      int [not null]
  lineTotal     decimal(18,2) [not null]
  createdAt     timestamp(3) [not null, default: `now()`]

  indexes {
    (saleId)
    (shopProductId)
  }

  Note: '''
  ต้อง snapshot ชื่อ/ราคา/ต้นทุนไว้ในบิล — ห้าม join ไป shop_products เพื่อแสดงบิลย้อนหลัง
  cost_price = ทุนของล็อตที่ถูกตัดจริง (FIFO) ใช้คิดกำไรย้อนหลัง
  ทุก sale_item ต้องมี StockMovement คู่กันใน transaction เดียวกัน
  '''
}

Table users {
  id                    uuid [pk]
  first_name            text [not null]
  last_name             text [not null]
  email                 text [null, note: 'unique แบบ case-insensitive เฉพาะบัญชีที่ยังไม่ถูกลบ (prisma/sql/004) — เจ้าของร้านเปลี่ยนได้ผ่าน POST /auth/email-change พนักงานเปลี่ยนไม่ได้']
  email_verified_at     timestamptz [null, note: 'NULL = ยังไม่ยืนยันอีเมล → login ด้วยรหัสผ่านไม่ได้ / สมัครด้วย Google ถือว่ายืนยันแล้วทันที']
  username              varchar(50) [null, note: 'unique เฉพาะบัญชีที่ยังไม่ถูกลบ (prisma/sql/004)']
  password              text [null, note: 'bcrypt hash — NULL ได้ถ้าสมัครด้วย LINE/Google ล้วน']
  line_user_id          text [unique, null]
  google_id             text [unique, null]
  owner_id              uuid [null, note: 'NULL = สมัครเอง / มีค่า = พนักงานที่เจ้าของร้านสร้างให้']
  role                  UserRole [not null]
  two_factor_enabled    boolean [not null, default: false]
  two_factor_secret_enc text [null, note: 'TOTP secret เข้ารหัสก่อนเก็บ']
  status                UserStatus [not null, default: 'ACTIVE']
  last_login_at         timestamptz [null]
  deleted_at            timestamptz [null, note: 'soft delete']
  created_at            timestamptz [not null, default: `now()`]
  updated_at            timestamptz [not null]

  indexes {
    (email) [name: 'idx_user_email']
    (username) [name: 'idx_user_username']
    (line_user_id) [name: 'idx_user_line']
    (google_id) [name: 'idx_user_google']
    (owner_id) [name: 'idx_user_owner']
  }

  Note: '''
  CHECK constraints ที่ service บังคับไว้ (Prisma/DB ไม่มี CHECK):
  1) มีอย่างน้อย 1 ช่องทาง login: email / username / line_user_id / google_id
  2) login ด้วย username ได้เมื่อมี password
  3) พนักงาน (SHOP_STAFF) ต้องมี username + password และ owner_id เสมอ
  UNIQUE จริงอยู่ที่ prisma/sql/004: lower(email) และ username เฉพาะแถวที่ deleted_at IS NULL
  ผูก Google ได้เฉพาะ SHOP_OWNER — บังคับที่ service ไม่ใช่ DB
  '''
}

Table refresh_tokens {
  id         uuid [pk]
  user_id    uuid [not null]
  token_hash text [unique, not null, note: 'เก็บ hash เท่านั้น ห้ามเก็บ token ดิบ']
  family_id  uuid [not null, note: 'รอบการ rotate เดียวกัน ใช้เพิกถอนทั้งสาย']
  used_at    timestamptz [null, note: 'ถ้าถูกใช้ซ้ำ = reuse detection']
  revoked_at timestamptz [null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id) [name: 'idx_refresh_token_user']
    (family_id) [name: 'idx_refresh_token_family']
  }
}

Table password_reset_tokens {
  id         uuid [pk]
  user_id    uuid [not null]
  token_hash text [not null]
  expires_at timestamptz [not null]
  used_at    timestamptz [null, note: 'ใช้ได้ครั้งเดียว']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id) [name: 'idx_password_reset_user']
  }

  Note: '''
  ใช้ได้เฉพาะบัญชีที่มี email ผูกไว้ — พนักงานรีเซ็ตเองไม่ได้ เจ้าของร้านเปลี่ยนให้เท่านั้น
  '''
}

Table email_verification_tokens {
  id            uuid [pk]
  user_id       uuid [not null]
  pending_email text [null]
  token_hash    text [unique, not null]
  expires_at    timestamptz [not null]
  used_at       timestamptz [null, note: 'ใช้ได้ครั้งเดียว']
  created_at    timestamptz [not null, default: `now()`]

  indexes {
    (user_id) [name: 'idx_email_verification_user']
  }

  Note: '''
  ยืนยันอีเมลตอนสมัครด้วยอีเมล — ไม่ได้อยู่ใน SRS เป็นข้อกำหนดเพิ่มจากทีม กันการสมัครด้วยอีเมลปลอม
  '''
}

Table admin_audit_logs {
  id          uuid [pk]
  actor_id    uuid [not null, note: 'Admin/Super Admin ที่ทำรายการ — restrict ไม่ให้ประวัติหายเมื่อลบบัญชี']
  action      AdminAuditAction [not null]
  target_type AdminAuditTargetType [not null]
  target_id   uuid [not null, note: 'ไม่มี FK เพราะชี้ได้ทั้ง users และ shops แล้วแต่ target_type']
  reason      text [null, note: 'เหตุผลที่ระงับ']
  metadata    jsonb [null, note: 'ข้อมูลเพิ่มเติมแล้วแต่ action เช่น เปลี่ยน role เก็บ { from, to }']
  created_at  timestamptz [not null, default: `now()`]

  indexes {
    (actor_id, created_at) [name: 'idx_admin_audit_actor']
    (target_type, target_id, created_at) [name: 'idx_admin_audit_target']
  }

  Note: '''
  APPEND-ONLY — ห้าม UPDATE/DELETE แถวเดิม (เหมือน stock_movements และ payments)
  '''
}

Table two_factor_recovery_codes {
  id         uuid [pk]
  user_id    uuid [not null]
  code_hash  text [not null]
  used_at    timestamptz [null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id) [name: 'idx_2fa_recovery_user']
  }

  Note: '''
  ระบุ 2FA (TOTP) ไว้ละเอียด: ทุก user เปิดเองได้จาก
  โปรไฟล์ (ไม่บังคับ), ต้องออก recovery codes ตอนเปิดสำเร็จ, ห้ามส่ง
  recovery codes ซ้ำผ่านช่องทางใดๆ ภายหลัง (รวมอีเมล) — ถ้าทำหายต้องให้
  Admin ปิด 2FA ให้ด้วยมือหลังยืนยันตัวตนนอกระบบ
  '''
}

Table categories {
  id            uuid [pk]
  owner_id      uuid [not null, note: 'หมวดหมู่เป็นของเจ้าของร้าน ใช้ร่วมกันได้ทุกร้าน']
  name          varchar(100) [not null]
  display_order int [not null, default: 0]
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null, default: `now()`]

  indexes {
    (owner_id, name) [unique, name: 'uq_category_owner_name']
  }

  Note: '''
  owner_id ไม่มี FK ในฐานข้อมูลจริง (เป็น uuid เปล่า) — ตรวจความเป็นเจ้าของที่ service
  '''
}

Table subscription_plans {
  id                        uuid [pk]
  code                      varchar(50) [unique, not null, note: 'FREE / PLUS / PRO']
  name_th                   varchar(100) [not null]
  price_thb                 decimal(12,2) [not null, note: 'ราคาต่อปี — ไม่มีแพ็กเกจรายเดือน']
  duration_months           int [null, note: '12 สำหรับ Paid Plan, NULL = Free Plan ไม่มีวันหมดอายุ']
  included_shop_quota       int [not null, default: 1, note: 'Free=1, Plus=3, Pro=5']
  included_staff_quota      int [not null, default: 0, note: 'Free=0 (ไม่รองรับพนักงาน), Plus=6, Pro=10']
  max_active_products       int [null, note: 'Free=100, Plus=3000, Pro=5000']
  chatbot_enabled           boolean [not null, default: false, note: 'Plus/Pro เท่านั้น']
  barcode_enabled           boolean [not null, default: false, note: 'Plus/Pro เท่านั้น']
  ai_recommendation_enabled boolean [not null, default: false, note: 'Pro เท่านั้น — ไม่ใช่ Plus']
  is_free                   boolean [not null, default: false]
  is_active                 boolean [not null, default: true]

  Note: '''
  Seed ต้องมีครบ 3 แถวตาม (ดู prisma/sql/003_seed_subscription_plans.sql
  และ SubscriptionPlanSeeder ซึ่งเป็นตัวเติมจริงตอนแอป boot):
  - FREE: price=0,    included_shop_quota=1, max_active_products=100,
          included_staff_quota=0,  chatbot=false, barcode=false, ai=false,
          duration_months=NULL, is_free=true
  - PLUS: price=2499, included_shop_quota=3, max_active_products=3000,
          included_staff_quota=6,  chatbot=true,  barcode=true,  ai=false,
          duration_months=12
  - PRO:  price=3499, included_shop_quota=5, max_active_products=5000,
          included_staff_quota=10, chatbot=true,  barcode=true,  ai=true,
          duration_months=12
  ทุก user ใหม่ต้องได้ subscriptions ชี้ไป plan FREE ทันทีตอนสมัคร

  ไม่มีการซื้อสิทธิ์ (ร้าน/สินค้า/พนักงาน) เพิ่มแยกต่างหากจากแพ็กเกจ
  ไม่ว่ากรณีใด — อัปเกรดได้เฉพาะเปลี่ยนไปแพ็กเกจที่สูงกว่าเท่านั้น
  '''
}

Table subscriptions {
  id                 uuid [pk]
  user_id            uuid [unique, not null, note: '1 เจ้าของร้าน = 1 subscription']
  plan_id            uuid [not null]
  status             SubscriptionStatus [not null, default: 'ACTIVE']
  started_at         timestamp(3) [not null]
  expires_at         timestamp(3) [null, note: 'NULL สำหรับ Free Plan']
  expiry_notified_at timestamp(3) [null, note: 'กันแจ้งเตือนซ้ำ — cron แจ้งเตือนในระบบล่วงหน้า 7 วันก่อนหมดอายุ']
  created_at         timestamp(3) [not null, default: `now()`]
  updated_at         timestamp(3) [not null]

  indexes {
    (expires_at) [name: 'idx_subscription_expires']
  }

  Note: '''
  quota ร้าน: allowed = subscription_plans.included_shop_quota
  used = COUNT(shops WHERE owner_id = user_id AND deleted_at IS NULL) คำนวณสดทุกครั้ง
  ลบร้าน (soft delete) จึงคืน quota ทันที
  การซื้อ/อัปเกรด/ต่ออายุมีผลเฉพาะใน POST /payments/:id/confirm หลัง Stripe ยืนยันว่าจ่ายแล้ว
  Plus -> Pro ระหว่างยังไม่หมดอายุ: จ่ายส่วนต่าง วันหมดอายุคงเดิม
  ต่ออายุ: เปิดได้ 30 วันก่อนหมดอายุ ต่อจากวันหมดอายุเดิม 12 เดือน
  ไม่มี downgrade
  read-only ไม่มีคอลัมน์เก็บ — คำนวณจาก status/expires_at ด้วย isSubscriptionReadOnly()
  และทุก write path ต้องเรียก AccountContextService.assertNotReadOnly() (ไม่มี guard กลาง)
  Free Plan (expires_at = NULL) ไม่มีวันเข้า read-only
  '''
}

Table payments {
  id              uuid [pk]
  user_id         uuid [not null]
  subscription_id uuid [null]
  purpose         PaymentPurpose [not null, note: 'NEW_SUBSCRIPTION (ซื้อ/อัปเกรด) หรือ RENEWAL (ต่ออายุ) — ไม่มีการซื้อ quota แยก']
  amount_thb      decimal(12,2) [not null]
  currency        char(3) [not null, default: 'THB']
  status          PaymentStatus [not null, default: 'PENDING']
  provider        varchar(50) [not null, note: 'stripe']
  provider_ref    text [unique, not null, note: 'Stripe PaymentIntent id — unique กันบันทึกซ้ำ']
  paid_at         timestamp(3) [null]
  created_at      timestamp(3) [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: 'idx_payment_user_date']
  }

  Note: '''
  append-only — ห้าม UPDATE ยอดเงิน คืนเงินให้สร้างแถวใหม่ status REFUNDED
  '''
}

Table shops {
  id          uuid [pk]
  owner_id    uuid [not null, note: 'ทุกร้านมีเจ้าของเพียงคนเดียว']
  name        varchar(150) [not null]
  description text [null]
  image_url   varchar(500) [null, note: 'Cloudinary']
  phone       varchar(20) [null, note: 'เก็บเป็น string เบอร์ไทยขึ้นต้นด้วย 0']
  address     text [null]
  latitude    decimal(9,6) [null, note: 'ปักหมุดตำแหน่งร้านผ่านแผนที่ (OpenStreetMap) — ไม่บังคับ']
  longitude   decimal(9,6) [null]
  status      ShopStatus [not null, default: 'ACTIVE', note: 'SUSPENDED ตั้งโดย Admin เท่านั้น']
  paused_at   timestamp(3) [null, note: 'เจ้าของพักร้านชั่วคราวเอง — คนละอย่างกับ status=SUSPENDED']
  deleted_at  timestamp(3) [null, note: 'soft delete — คืน quota ให้เจ้าของทันที (ดู Note ของ subscriptions)']
  created_at  timestamp(3) [not null, default: `now()`]
  updated_at  timestamp(3) [not null]

  indexes {
    (owner_id, deleted_at) [name: 'idx_shop_owner']
  }

  Note: '''
  เมื่อลบร้าน (soft delete) ต้องทำในทรานแซกชันเดียวกับ:
  - ตั้ง shop_products.status = INACTIVE ทุกแถวของร้านนี้ (products จริงไม่ถูกลบ)
  - ตั้ง shop_staffs.removed_at ให้พนักงานทุกคนของร้านนี้ (ไม่ลบบัญชี users)
  - stock_movements / sales / sale_items ห้ามแตะ เก็บไว้เป็นหลักฐานตลอด
  '''
}

Table shop_staffs {
  id          uuid [pk]
  shop_id     uuid [not null]
  user_id     uuid [not null]
  assigned_at timestamptz [not null, default: `now()`]
  removed_at  timestamptz [null, note: 'soft remove — เก็บประวัติผู้ทำรายการไว้']

  indexes {
    (shop_id, user_id) [unique, name: 'uq_shop_staff']
    (user_id, removed_at) [name: 'idx_shop_staff_user']
  }

  Note: '''
  เจ้าของร้านไม่มีแถวในตารางนี้ — สิทธิ์เต็มมาจาก shops.owner_id โดยตรง
  พนักงาน 1 คนมอบหมายได้หลายร้าน แต่นับเป็น 1 คนใน staff_quota เสมอ — ต้องนับจาก users ที่มี owner_id ชี้มา ไม่ใช่นับแถวในตารางนี้
  '''
}

Table staff_permissions {
  id                      uuid [pk]
  shop_staff_id           uuid [unique, not null, note: '1:1 กับ shop_staffs — สิทธิ์กำหนดแยกรายร้าน']
  can_manage_product      boolean [not null, default: false]
  can_adjust_stock_manual boolean [not null, default: false]
  can_use_chatbot         boolean [not null, default: false]
  can_scan_sale           boolean [not null, default: false]
  can_view_dashboard      boolean [not null, default: false]
  can_view_ai_insight     boolean [not null, default: false]
  granted_by              uuid [null, note: 'user id ของเจ้าของร้านที่แก้ไขล่าสุด']
  updated_at              timestamptz [not null, default: `now()`]

  Note: '''
  boolean column แทนที่แบบ 1 แถวต่อ 1 สิทธิ์เดิม — เลือกแบบนี้เพราะจำนวน
  สิทธิ์คงที่และน้อย (6 อย่าง ตรงกับ ) และต้องเช็คสิทธิ์ทั้งชุดของ
  คนคนเดียวทุก request จึง query ง่ายกว่า (1 แถวจบ ไม่ต้อง aggregate)
  ค่าเริ่มต้นเมื่อสร้างบัญชีพนักงานใหม่ = false ทั้งหมด ตรงกับ "พนักงานใหม่ไม่มีสิทธิ์ใดๆ จนกว่าเจ้าของร้านจะเปิดให้"

  ระบบต้องเช็คทั้ง 2 ชั้นก่อนอนุญาต action ของพนักงาน:
  1) staff_permissions ของแถวนี้ (สิทธิ์ที่เจ้าของร้านเปิดให้)
  2) subscription_plans ของเจ้าของร้าน (เช่น can_use_chatbot=true แต่ plan
     เป็น FREE ที่ chatbot_enabled=false ก็ยังใช้ไม่ได้ )
  '''
}

Table products {
  id          uuid [pk]
  owner_id    uuid [not null, note: 'คลังกลางของเจ้าของร้าน ไม่ผูกกับ shop โดยตรง']
  category_id uuid [null]
  name        varchar(200) [not null, note: 'ค้นหาด้วยชื่อ (ILIKE)']
  barcode     varchar(50) [null, note: 'unique ภายในคลังของเจ้าของร้านเดียวกัน ไม่ใช่ทั้งระบบ']
  unit        varchar(20) [not null, note: 'ชิ้น / ขวด / แพ็ค / กล่อง']
  image_url   varchar(500) [null]
  deleted_at  timestamptz [null, note: 'soft delete บังคับตาม (ระดับคลังกลาง)']
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]

  indexes {
    (owner_id, deleted_at) [name: 'idx_product_owner_deleted']
    (owner_id, name) [name: 'idx_product_owner_name']
    (category_id) [name: 'idx_product_category']
  }

  Note: '''
  sell_price / cost_price / stock_qty / low_stock_threshold อยู่ใน shop_products
  เพราะแต่ละร้านของเจ้าของคนเดียวกันตั้งค่าต่างกันได้
  active product quota (100 / 3,000 / 5,000) นับจาก products ที่ deleted_at IS NULL ของ owner_id นี้
  สินค้าเดียวกันขายหลายร้านนับ quota แค่ 1 รายการ
  owner_id ไม่มี FK ในฐานข้อมูลจริง (เป็น uuid เปล่า) — ตรวจความเป็นเจ้าของที่ service
  PARTIAL UNIQUE (owner_id, barcode) WHERE deleted_at IS NULL AND barcode IS NOT NULL
  อยู่ใน prisma/sql/001 (SqlScriptsRunner รันให้ตอนบูต)
  '''
}

Table shop_products {
  id                  uuid [pk]
  shop_id             uuid [not null]
  product_id          uuid [not null]
  sell_price          decimal(12,2) [not null, note: 'ราคาขายเฉพาะร้านนี้ แต่ละร้านตั้งต่างกันได้']
  cost_price          decimal(12,2) [not null, note: 'ต้นทุนตั้งต้นของล็อตใหม่ที่ไม่ได้ระบุต้นทุน และค่าสำรองของสินค้าที่ยังไม่มีล็อต']
  stock_qty           int [not null, default: 0, note: 'cache ยอดคงเหลือเฉพาะร้านนี้ ต้องอัปเดตใน transaction เดียวกับ stock_movements เสมอ']
  low_stock_threshold int [not null, default: 0, note: 'เฉพาะร้านนี้']
  status              shop_product_status [not null, default: 'ACTIVE', note: 'ร้านนี้ยังขายสินค้านี้จากคลังกลางอยู่ไหม (opt-in/opt-out)']
  created_at          timestamptz [not null, default: `now()`]
  updated_at          timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, product_id) [unique, name: 'uq_shop_product']
    (shop_id, status) [name: 'idx_shop_product_shop_status']
    (product_id) [name: 'idx_shop_product_product']
  }

  Note: '''
  ตัวกลาง many-to-many ระหว่าง shops กับ products — ทำให้เจ้าของร้าน
  เพิ่มสินค้าครั้งเดียวแล้วเลือกขายได้หลายร้านของตัวเอง โดยแต่ละร้าน
  มีราคา/สต็อกอิสระจากกัน
  CHECK (stock_qty >= 0)
  '''
}

Table stock_lots {
  id              uuid [pk]
  shop_product_id uuid [not null]
  unit_cost       decimal(12,2) [not null, note: 'ทุนต่อชิ้นของล็อตนี้ — ล็อตที่เปิดแล้วห้ามแก้ทุน']
  qty_received    int [not null, note: 'จำนวนตอนรับเข้า ไม่เปลี่ยนอีก']
  qty_remaining   int [not null, note: 'เหลือเท่าไหร่ ลดลงเรื่อยๆ ตอนถูกตัด — 0 แล้วยังเก็บไว้ ไม่ลบ']
  note            text [null]
  received_at     timestamptz [not null, default: `now()`]
  created_at      timestamptz [not null, default: `now()`]

  indexes {
    (shop_product_id, received_at) [name: 'idx_stock_lot_fifo']
  }

  Note: '''
  ต้นทุนแยกตามล็อตที่รับเข้า ตัดของเก่าก่อน (FIFO)

  ทำไมต้องมี: shop_products.cost_price เก็บได้ค่าเดียว พอรับของล็อตใหม่ที่ทุน
  ไม่เท่าเดิม ของเก่าที่ยังขายไม่หมดจะถูกตีเป็นราคาใหม่ไปด้วย กำไรของที่ยังไม่ได้
  ขายจึงคลาดเคลื่อนทันที โดยไม่มีอะไรเตือนเพราะตัวเลขยังดูปกติ

  ล็อตตั้งต้นถูกสร้างแบบ lazy จาก stock_qty/cost_price ที่มีอยู่ ตอนสินค้าตัวนั้น
  ถูกตัดครั้งแรก — ไม่ใช้สคริปต์ backfill เพราะจะต้องหยุดระบบ
  '''
}

Table notifications {
  id         uuid [pk]
  user_id    uuid [not null, note: 'ผู้รับ']
  shop_id    uuid [null]
  type       notification_type [not null]
  title      varchar(200) [not null]
  message    text [not null]
  payload    jsonb [null]
  read_at    timestamptz [null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, read_at) [name: 'idx_notification_unread']
  }
}

Table chat_messages {
  id                uuid [pk]
  shop_id           uuid [not null]
  user_id           uuid [not null]
  channel           chat_channel [not null]
  role              chat_role [not null]
  content           text [not null]
  pending_action_id uuid [null]
  created_at        timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, user_id, created_at) [name: 'idx_chat_scope_date']
  }

  Note: '''
  AI Chat จำกัดสิทธิ์ตามช่องทางที่ผูกกับบัญชี ณ ปัจจุบัน: ผูก LINE ไว้ใช้ได้ทั้งเว็บและ LINE
  ไม่ได้ผูกใช้ได้เฉพาะเว็บ — เช็ค users.line_user_id สดทุกครั้ง
  pending_action_id เป็น uuid เปล่า ไม่มี FK ไปที่ PendingAction
  '''
}

Table chat_shop_prompts {
  id               uuid [pk]
  user_id          uuid [unique, not null, note: 'unique เพื่อให้คำถามใหม่ทับของเก่าด้วย upsert — คนหนึ่งค้างได้คำถามเดียว']
  original_message text [not null]
  selected_shop_id uuid [null, note: 'ร้านที่ผู้ใช้เพิ่งเลือก — ว่าง = ยังไม่ได้เลือก (เลขที่พิมพ์มาแปลว่า "เลือกร้าน") มีค่า = เลือกแล้ว (เลขที่พิมพ์มาแปลว่า "เลือกสินค้า" และ "ยืนยัน" ใช้ร้านนี้)  จำเป็นเพราะข้อความ LINE ทุกครั้งมาแบบไร้บริบท ถ้าไม่จำไว้ พอผู้ใช้พิมพ์ "ยืนยัน" ระบบจะถามว่าร้านไหนซ้ำอีกรอบ วนไม่จบ']
  expires_at       timestamptz [not null]
  created_at       timestamptz [not null, default: `now()`]

  Note: '''
  จำคำสั่งที่ผู้ใช้พิมพ์มา ระหว่างรอให้เลือกว่าหมายถึงร้านไหน — ใช้เฉพาะกับ
  บัญชีที่มีหลายร้าน และเฉพาะช่องทาง LINE (ฝั่งเว็บรู้ร้านจากตัวสลับร้านอยู่แล้ว)

  แยกจาก pending_stock_actions เพราะตอนถามว่า "ร้านไหน" ยังไม่รู้ shop_id
  แต่ตารางนั้นบังคับว่าต้องมี

  user_id เป็น unique โดยตั้งใจ — คนหนึ่งค้างได้คำถามเดียว คำถามใหม่ทับของเก่า
  ด้วย upsert จึงไม่ต้องมีงานตามเก็บกวาดแถวค้าง
  '''
}

Table ai_recommendations {
  id              uuid [pk]
  shop_id         uuid [not null]
  shop_product_id uuid [null, note: 'NULL = คำแนะนำระดับร้าน ไม่เจาะจงสินค้า']
  type            ai_recommendation_type [not null]
  title           varchar(200) [not null]
  content         text [not null, note: 'ข้อความไทยที่แสดงบนแดชบอร์ด']
  metrics         jsonb [null, note: 'ตัวเลขที่ AI ใช้อ้างอิง เช่น ยอดขาย 30 วัน']
  generated_at    timestamptz [not null, default: `now()`]
  valid_until     timestamptz [null]
  is_dismissed    boolean [not null, default: false]

  indexes {
    (shop_id, generated_at) [name: 'idx_ai_reco_shop_date']
  }

  Note: '''
  ใช้ได้เฉพาะ Pro — เช็ค subscription_plans.ai_recommendation_enabled ก่อนเรียก LLM ทุกครั้ง
  สร้างใหม่เมื่อผู้ใช้กดขอ (POST /shops/:shopId/ai/recommendations/generate) แล้วเก็บไว้ในตารางนี้
  และ push ให้ทุกคนที่เปิดร้านนั้นผ่าน Socket.io — ไม่เรียก LLM ตอน render หน้า
  '''
}

Table _sql_scripts {
  filename   text [pk]
  checksum   text [not null]
  applied_at timestamptz [not null, default: `now()`]

  Note: '''
  ledger ของ SqlScriptsRunner — บันทึกว่าไฟล์ไหนใน prisma/sql/ รันไปแล้ว ไม่ใช่ข้อมูลธุรกิจ
  '''
}

// ---------------------------------------------------------------------
// RELATIONSHIPS — every foreign key that exists in the database
// ---------------------------------------------------------------------
Ref: StockMovement.shopId > shops.id [delete: restrict]
Ref: StockMovement.shopProductId > shop_products.id [delete: restrict]
Ref: StockMovement.actorId > users.id [delete: restrict]
Ref: StockMovement.sale_id > Sale.id [delete: restrict]
Ref: StockMovement.pending_action_id > PendingAction.id [delete: restrict]
Ref: PendingAction.shopId > shops.id [delete: restrict]
Ref: PendingAction.destination_shop_id > shops.id [delete: restrict]
Ref: PendingAction.shopProductId > shop_products.id [delete: restrict]
Ref: PendingAction.actorId > users.id [delete: restrict]
Ref: Sale.shopId > shops.id [delete: restrict]
Ref: Sale.staffId > users.id [delete: restrict]
Ref: Sale.voidedById > users.id [delete: restrict]
Ref: SaleItem.saleId > Sale.id [delete: restrict]
Ref: SaleItem.shopProductId > shop_products.id [delete: restrict]
Ref: users.owner_id > users.id [delete: restrict]
Ref: refresh_tokens.user_id > users.id [delete: cascade]
Ref: password_reset_tokens.user_id > users.id [delete: cascade]
Ref: email_verification_tokens.user_id > users.id [delete: cascade]
Ref: admin_audit_logs.actor_id > users.id [delete: restrict]
Ref: two_factor_recovery_codes.user_id > users.id [delete: cascade]
Ref: subscriptions.user_id - users.id [delete: restrict]
Ref: subscriptions.plan_id > subscription_plans.id [delete: restrict]
Ref: payments.user_id > users.id [delete: restrict]
Ref: payments.subscription_id > subscriptions.id [delete: set null]
Ref: shops.owner_id > users.id [delete: restrict]
Ref: shop_staffs.shop_id > shops.id [delete: cascade]
Ref: shop_staffs.user_id > users.id [delete: restrict]
Ref: staff_permissions.shop_staff_id - shop_staffs.id [delete: cascade]
Ref: staff_permissions.granted_by > users.id [delete: set null]
Ref: products.category_id > categories.id [delete: set null]
Ref: shop_products.product_id > products.id [delete: restrict]
Ref: shop_products.shop_id > shops.id [delete: cascade]
Ref: stock_lots.shop_product_id > shop_products.id [delete: restrict]
Ref: notifications.user_id > users.id [delete: cascade]
Ref: notifications.shop_id > shops.id [delete: cascade]
Ref: chat_messages.shop_id > shops.id [delete: cascade]
Ref: chat_messages.user_id > users.id [delete: restrict]
Ref: chat_shop_prompts.user_id - users.id [delete: cascade]
Ref: chat_shop_prompts.selected_shop_id > shops.id [delete: cascade]
Ref: ai_recommendations.shop_id > shops.id [delete: cascade]
Ref: ai_recommendations.shop_product_id > shop_products.id [delete: cascade]

// Stored as plain uuids with no foreign key in the database (checked in code):
//   products.owner_id   -> users.id
//   categories.owner_id -> users.id
//   chat_messages.pending_action_id -> PendingAction.id
//   admin_audit_logs.target_id -> users.id or shops.id (by target_type)

// ---------------------------------------------------------------------
// TABLE GROUPS
// ---------------------------------------------------------------------

TableGroup auth {
  users
  refresh_tokens
  password_reset_tokens
  email_verification_tokens
  two_factor_recovery_codes
  admin_audit_logs
}

TableGroup billing {
  subscription_plans
  subscriptions
  payments
}

TableGroup shop_management {
  shops
  shop_staffs
  staff_permissions
}

TableGroup catalog_inventory {
  categories
  products
  shop_products
  stock_lots
  StockMovement
}

TableGroup sales {
  Sale
  SaleItem
}

TableGroup ai_platform {
  PendingAction
  chat_messages
  chat_shop_prompts
  ai_recommendations
  notifications
}
