# --- Server ---
PORT=8000
FRONTEND_URL=

# --- Database (PostgreSQL) ---
DATABASE_URL=

# --- Stock / chat ---
PENDING_ACTION_TTL_MINUTES=15

# Use in-memory sales adapters only for isolated local testing.
# Any value other than "true" uses the real Prisma adapters.
SALES_MOCK_MODE=false

# --- JWT ---
ACCESS_TOKEN_SECRET=
# หน่วยเป็นวินาที — access token เพิกถอนกลางคันไม่ได้ (เป็น JWT ไม่ใช่แถวใน DB)
# ยิ่งอายุยาว ยิ่งเป็นช่วงที่ token ที่หลุดออกไปแล้วยังใช้ได้ 900 = 15 นาที
# ตามมาตรฐานทั่วไป ฝั่งเว็บต่ออายุเองอัตโนมัติผ่าน POST /auth/refresh อยู่แล้ว
ACCESS_TOKEN_EXPIRES_IN=900
# 2592000 = 30 วัน
REFRESH_TOKEN_EXPIRES_IN=2592000
RESET_TOKEN_EXPIRES_IN=
# อายุลิงก์ยืนยันอีเมล (วินาที) เช่น 86400 = 24 ชม.
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Two-Factor Authentication (TOTP) ---
# คีย์สำหรับเข้ารหัส two_factor_secret ก่อนเก็บลง DB (32 bytes hex)
TWO_FACTOR_ENCRYPTION_KEY=
# คีย์เซ็น challenge token ระหว่างรอกรอกรหัส 6 หลัก — บังคับ อย่างน้อย 32 ตัว
# ไม่ใส่ = api boot ไม่ขึ้นเลย (env.validation บังคับไว้)
TWO_FACTOR_CHALLENGE_SECRET=

# --- LINE (Login + Messaging API) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# --- AI ---
# Ollama (local/dev) — AI chatbot จะเปิดใช้เมื่อมีทั้ง HOST และ MODEL
# ถ้าใช้ Ollama ในเครื่องนี้ ให้ใช้ค่าประมาณนี้:
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:2b
# OLLAMA_API_KEY=     # เว้นว่างได้สำหรับ Ollama local; ใช้เฉพาะกรณีมี gateway ที่ต้อง auth
OLLAMA_HOST=
OLLAMA_API_KEY=
OLLAMA_MODEL=

# --- File/Image storage ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Payment ---
# optional — ไม่ใส่ก็ boot ขึ้นปกติ แต่ endpoint ของ PaymentsModule
# จะตอบ 503 พร้อมบอกว่าขาดตัวไหน
#
# ไม่ต้องตั้ง STRIPE_WEBHOOK_SECRET และไม่ต้องเปิด `stripe listen` — ระบบนี้
# ไม่ใช้ webhook แล้ว การชำระเงินยืนยันที่ POST /payments/:id/confirm ทันที
# ที่ฟอร์มบัตรผ่าน และมี listMyPayments() เป็นตาข่ายรองเผื่อผู้ใช้ปิดหน้าเว็บ
STRIPE_SECRET_KEY=

# --- Mail (Brevo) ---
# ส่งผ่าน HTTP API ของ Brevo ไม่ใช่ SMTP เพราะ Railway ปิด outbound SMTP
# (port 25/465/587) ทุกแพลนยกเว้น Pro — ค่า SMTP_* เดิมเลิกใช้แล้ว ลบทิ้งได้
#
# optional — ไม่ใส่ก็ boot ขึ้นปกติ แต่เวลาส่งเมลจริงจะได้ 503
# ขอ key ฟรีได้ที่ https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=
# ต้องเป็นอีเมลที่ verify เป็น sender ใน Brevo แล้ว (Senders → Add a sender
# แล้วกรอกรหัส 6 หลักที่ส่งไปในเมล) ไม่งั้น Brevo ตอบ 400 กลับมา
MAIL_FROM=
# ชื่อผู้ส่งที่ผู้รับเห็น — ไม่ใส่ก็ได้
MAIL_FROM_NAME="Aum Manage Stocks"
